# SuMi Profile Backend Environment Configuration
PORT=3000
NODE_ENV=development

# Supabase Credentials (optional for offline/mock development)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Optional API key for protected write endpoints (/api/exp/*)
BACKEND_API_KEY=

# Optional public base URL for absolute report image URLs
PUBLIC_BASE_URL=https://sumi-profile-backend.onrender.com

# Fallback Settings
DEFAULT_AVATAR_URL=
DEFAULT_BG_COLOR=#0d0b1a
